# Copy this file to .env and fill in your key(s). Never commit .env.

# Sarvam API key (the regular sk_... key from dashboard.sarvam.ai -> API Keys, NOT the Voice Agents sk_samvaad key).
# One key covers speech-to-text, the Bulbul v3 voice, and (by default) the LLM.
SARVAM_API_KEY=

# Which LLM decides the replies: sarvam (default, best for Indian languages, ~₹0.60/min)
#                                groq   (cheapest + fastest, ~₹0.10/min, best in English/Hindi)
LLM_PROVIDER=sarvam
SARVAM_LLM_MODEL=sarvam-105b-conversations
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Voice model: bulbul:v4-flash (₹20 per 10K chars, newer) or bulbul:v3 (₹30)
TTS_MODEL=bulbul:v3
# v4 voices are named speaker_language_style. Good for calls (Sarvam's picks):
#   Hindi female: aparna_hi_customer, aarti_hi_customer, ritu_hi_sales, simran_hi_sales, ritu_hi_conversation
#   Hindi male:   shubh_hi_customer, aditya_hi_sales, tarun_hi_sales, rahul_hi_conversational
#   Hinglish:     simran_enhi_customer, ishita_enhi_customer, shubh_enhi_banking
#   English:      simran_en_sales, aparna_en_companion, sunny_en_social
# Full list: v4_voices.txt   (v3 voices if TTS_MODEL=bulbul:v3: priya, ritu, kavya, shubh, rahul ...)
TTS_VOICE=priya
TTS_LANGUAGE=te-IN
TTS_PACE=1.0
# v4 only: pitch -0.5..0.5, loudness 0.1..2.5
TTS_PITCH=0.0
TTS_LOUDNESS=1.0
# When the caller switches language, hand over to a native voice of that language (v4 only).
# Override per language with TTS_VOICE_TE / _KN / _MR / _BN / _GU / _EN.
TTS_NATIVE_VOICES=true

# First line the agent says (Hindi words in Hindi script, English words in English):
# GREETING=नमस्ते! मैं Priya बोल रही हूँ, Bright Future Academy से। ...
# v3 only: 0.01..1.0 (higher = more expressive)
TTS_TEMPERATURE=0.6

# ---- Phone calls (phone_server.py) ----
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=
PUBLIC_URL=
CALL_SECRET=

# ---- Conversation ----
# Languages allowed on a call (first = start language). Stops wrong switches when phone speech-to-text mislabels "hello".
CALL_LANGUAGES=te-IN,en-IN,hi-IN
# Longest reply, in sentences (enforced in code).
MAX_SENTENCES=2
# Play a pre-made "जी।" / "సరే." the instant the caller stops talking, while the reply is prepared.
INSTANT_ACK=true
# Seconds of silence before Priya answers when the turn model is unsure the caller has finished (was 3 s).
TURN_MAX_SILENCE=0.7
# Share of turns that get the instant "जी।" (never two in a row). 0 = never.
ACK_RATE=0.4

# ---- Security ----
ADMIN_SECRET=
MAX_ACTIVE_CALLS=5
MAX_DIALS_PER_DAY=200
LOG_RETENTION_DAYS=30
# Lock speech-to-text to one language (te-IN). Empty = auto-detect (misheard Telugu as Tamil on phone audio).
STT_LANGUAGE=te-IN
